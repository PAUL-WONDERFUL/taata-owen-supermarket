generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // one of: SUPER_ADMIN, MANAGER, STAFF -- validated in lib/permissions.js, not a DB enum
  isProtected  Boolean  @default(false) // cannot be deleted or demoted via the dashboard, even by another Super Admin -- set directly in the DB, never exposed as a toggle in the UI
  createdAt    DateTime @default(now())
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id          String            @id @default(cuid())
  name        String
  description String?
  price       Int? // flat price; null when the item uses variants instead
  categoryId  String
  category    MenuCategory      @relation(fields: [categoryId], references: [id])
  imageUrl    String?
  isAvailable Boolean           @default(true)
  sortOrder   Int               @default(0)
  variants    MenuItemVariant[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MenuItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label      String // e.g. "1kg", "2kg", "Slice", "Medium", "Large"
  price      Int
  sortOrder  Int      @default(0)
}

enum GalleryCategory {
  SUPERMARKET
  RESTAURANT
  FOOD
  PRODUCTS
  EVENTS
  OTHER
}

model GalleryImage {
  id        String          @id @default(cuid())
  url       String
  category  GalleryCategory
  caption   String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
}

// Single-row table (id is always "singleton") for site-wide look-and-feel
// settings that are NOT public gallery content -- e.g. the building photo
// used as the Home splash/hero and admin login background. Super Admin only.
model SiteSettings {
  id                 String   @id @default("singleton")
  backgroundImageUrl String?
  updatedAt          DateTime @updatedAt
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  originalPrice Int? // shown crossed out next to the offer price, when set
  price       Int?
  startDate   DateTime
  endDate     DateTime
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
